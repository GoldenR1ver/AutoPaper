# 复制为 .env 后填写。至少配置一个兼容 OpenAI 的对话接口，摘要打分和论文精读才会启用。
OPENAI_API_KEY=
OPENAI_BASE_URL=
AUTOPAPER_MODEL=

# 可选。没有密钥也能检索，只是 Semantic Scholar 和 PubMed 更容易被限速。
S2_API_KEY=
NCBI_API_KEY=
NCBI_EMAIL=

# 可选。也可以写在 autopaper.yaml 的 mailto。
AUTOPAPER_MAILTO=

# 设为 1 时，定时任务只做检索和启发式排序，不调用模型，也不做语义召回。
AUTOPAPER_DISABLE_LLM=

# 可选。对话和向量不是同一家时再填。例如对话用 DeepSeek，向量用 OpenAI。
# AUTOPAPER_EMBEDDING_BASE_URL=https://api.openai.com/v1
# AUTOPAPER_EMBEDDING_API_KEY=
# AUTOPAPER_EMBEDDING_MODEL=text-embedding-3-small
# 设为 1 时只跳过语义召回，精读和打分仍然可用。
# AUTOPAPER_DISABLE_EMBEDDING=
